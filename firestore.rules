rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(shopId) { return signedIn() && request.auth.uid == shopId; }
    function publicShop(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.isPublic == true;
    }
    match /shops/{shopId} {
      allow get: if resource.data.isPublic == true || owner(shopId);
      allow list: if resource.data.isPublic == true;
      allow write: if false;  // Only privileged callable functions may edit stores.
      match /products/{productId} {
        allow get: if owner(shopId) || (resource.data.published == true && publicShop(shopId));
        allow list: if owner(shopId) || (resource.data.published == true && publicShop(shopId));
        allow write: if false; // Never let browsers inject unverified affiliate URLs.
      }
    }
    match /affiliateSecrets/{uid} {
      allow read, write: if false; // Encrypted credentials; Firebase Admin SDK only.
    }
    match /{document=**} {allow read, write: if false;}
  }
}